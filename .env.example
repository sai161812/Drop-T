# Server Configuration
PORT=3001
NODE_ENV=development
DATA_DIR=./data
UPLOAD_DIR=./uploads

# Groq API Configuration (Multi-Key Pool Support for Fast, Zero-Interruption 50-Persona Simulation)
# You can add 1, 2, 3, or more free API keys from https://console.groq.com/keys
# Adding 2 or 3 keys balances token load and runs all 50 personas in ~10-15s with 0ms rate-limit failover!
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=

# Alternatively, comma-separated keys:
# GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3

GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.2
GROQ_MAX_RETRIES=5

# Optional comparable-product search credentials (Brave, Tavily, Serper)
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
