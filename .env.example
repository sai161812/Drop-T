# Application
PORT=3001
NODE_ENV=development
DATA_DIR=./data
UPLOAD_DIR=./uploads

# Synthetic Lab (optional locally; required for live AI persona evaluations)
# Add one Groq API key. Additional keys are optional fallbacks for rate limits.
GROQ_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
# Or supply a comma-separated pool instead of individual fallback keys:
# GROQ_API_KEYS=gsk_key_1,gsk_key_2

# Evaluation settings
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.2
GROQ_MAX_RETRIES=15

# Comparable-product research (all optional; configure any supported provider)
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
