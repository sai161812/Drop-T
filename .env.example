# Server Configuration
PORT=3001
NODE_ENV=development
DATA_DIR=./data
UPLOAD_DIR=./uploads

# Groq configuration. Keys in the same organization share rate limits.
# One working key is enough. Free-tier reviews may need several minutes.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=

# Alternatively, comma-separated keys:
# GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3

GROQ_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.2
GROQ_MAX_RETRIES=15

# Optional comparable-product search credentials (Brave, Tavily, Serper)
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
