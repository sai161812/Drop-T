# Server Configuration
PORT=3001
NODE_ENV=development
DATA_DIR=./data
UPLOAD_DIR=./uploads

# Groq API Configuration (Server-Only — NEVER expose to client)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_MAX_RETRIES=5

# Optional comparable-product search credentials.
# Search selects the first configured provider in this order: Brave, Tavily, Serper.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
